# Lightweight local teammate setup. No GPU or Qwen download is required.
CARMA_DATABASE_URL=sqlite:///./carma.db
CARMA_UPLOAD_DIR=uploads
CARMA_ANALYSIS_DIR=uploads/analysis
CARMA_STORAGE_BACKEND=local
CARMA_MODEL_VERSION=dinov2-onnx-int8-svm-local-v2
CARMA_QWEN_QUALITY_ENABLED=false
CARMA_QWEN_DAMAGE_ENABLED=false
CARMA_ANGLE_CLASSIFIER_ENABLED=true
CARMA_ANGLE_CLASSIFIER_BACKEND=dinov2_onnx
CARMA_ANGLE_CLASSIFIER_RETAKE_CONFIDENCE=0.72
CARMA_DINOV2_ANGLE_CLASSIFIER_DIR=models/dinov2_angle_classifier
CARMA_DINOV2_ONNX_PATH=models/dinov2_angle_classifier/dinov2_vits14_matmul_int8.onnx
CARMA_DINOV2_DEVICE=cpu
CARMA_CLEANLINESS_ANALYSIS_ENABLED=false
CARMA_VEHICLE_DETECTOR_ENABLED=true
